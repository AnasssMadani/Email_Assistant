{
  "name": "global-link-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI email operations platform (multi-tenant refonte). See docs/architecture/refonte-plan.md.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate -w @global-link/db",
    "db:migrate": "npm run migrate -w @global-link/db"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
