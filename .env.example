# Root env for the new monorepo (apps/, packages/). The legacy app has its own
# .env.example at legacy/.env.example — do not mix the two.

# --- Supabase Postgres (see packages/db/README.md for one-time setup) ---
# Pooled (pgbouncer, port 6543) — used by apps/api and apps/worker at runtime.
DATABASE_URL=
# Direct (port 5432) — used only for migrations (packages/db) and pg-boss
# (packages/queue), both of which need session-level features pgbouncer's
# transaction mode doesn't support.
DIRECT_DATABASE_URL=

# --- Supabase project (Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Project Settings → API → JWT Secret — used by packages/auth to verify session
# tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model routing by task (see packages/ai/src/router.ts) — override per environment
# without a code change.
CLASSIFY_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-sonnet-5

# --- Token encryption (mailbox OAuth tokens at rest, and OAuth `state` signing) ---
# AES-256 key, 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Gmail OAuth (Google Cloud Console — one "Web application" OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4400/auth/gmail/callback

# --- Microsoft Graph OAuth (Azure AD app registration, per-tenant) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:4400/auth/graph/callback

# --- Ports ---
API_PORT=4400
WEB_PORT=4300

# --- Pipeline behaviour (see CLAUDE.md "Standing constraint") ---
APP_TIMEZONE=Africa/Casablanca
MAX_EXTERNAL_RELANCES_PER_CYCLE=5
# Suppresses all real sends for pilot-week verification — classification/templating
# still run so the pipeline can be inspected end to end (see packages/core).
SHADOW_MODE=false

# --- apps/web (Next.js) — public, exposed to the browser ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4400
